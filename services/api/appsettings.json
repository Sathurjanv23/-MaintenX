{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "KeyId": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RetiredKeyRetentionHours": 24,
    "VerificationKeys": {}
  },
  "TrustedProxies": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "RateLimiting": {
    "RegistrationPermitLimit": 5,
    "LoginPermitLimit": 10,
    "RefreshPermitLimit": 30,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  }
}
