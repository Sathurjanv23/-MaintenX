<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!--
      PRODUCTION TARGET: net10.0 (.NET 10 LTS)
      LOCAL STATUS: Blocked on net10.0 due to missing .NET 10 SDK (only .NET SDK 8.0.425 is installed on this host).
      Targeting net10.0 directly requires installing .NET 10 SDK from https://dotnet.microsoft.com/download/dotnet/10.0.
      Defaulting to net8.0 for local builds; can be overridden via /p:TargetFrameworkOverride=net10.0.
    -->
    <TargetFramework Condition="'$(TargetFrameworkOverride)' != ''">$(TargetFrameworkOverride)</TargetFramework>
    <TargetFramework Condition="'$(TargetFrameworkOverride)' == ''">net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MaintenX.Worker</RootNamespace>
    <AssemblyName>MaintenX.Worker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>
</Project>
