# ==============================================================================
# MaintenX Development Environment Configuration (.env.example)
# Copy this file to .env for local Docker Compose and development execution.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (PostgreSQL Superuser / Administrator)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=your_secure_admin_password_here
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database Configuration (Restricted Application Role)
POSTGRES_APP_USER=maintenx_app
POSTGRES_APP_PASSWORD=your_secure_app_password_here
POSTGRES_APP_DB=maintenx_dev

# ASP.NET Core API Configuration
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5000
API_HTTPS_PORT=5001
ConnectionStrings__AdminConnection="Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=your_secure_admin_password_here;"
ConnectionStrings__TestConnection="Host=localhost;Port=5432;Database=postgres;Username=maintenx_app;Password=your_secure_app_password_here;"
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=maintenx_dev;Username=maintenx_app;Password=your_secure_app_password_here;Maximum Pool Size=50;"
TestDatabase__AllowProvisioning=true
TestDatabase__AllowedHosts="localhost;127.0.0.1;postgres"

# JWT Authentication Configuration (FEAT-002)
# Production requires base64-encoded signing key with at least 256 bits (32 bytes).
Jwt__Issuer="https://api.maintenx.internal"
Jwt__Audience="https://maintenx.internal"
Jwt__KeyId="local-dev-key-2026-v1"
# Generate secure key via: openssl rand -base64 32
Jwt__SigningKey="your_base64_encoded_256bit_signing_key_here"
Jwt__AccessTokenLifetimeMinutes=15

# Trusted Reverse Proxy Configuration
# Production requires explicit allowlist of reverse proxy IPs or CIDR networks
TrustedProxies__KnownProxies="127.0.0.1;::1"
TrustedProxies__KnownNetworks=""
TrustedProxies__ForwardLimit=1

# Next.js Web Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Mobile (Flutter) Configuration
MOBILE_API_BASE_URL=http://10.0.2.2:5000

