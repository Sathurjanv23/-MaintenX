# ==============================================================================
# MaintenX Development Environment Configuration (.env.example)
# Copy this file to .env for local Docker Compose and development execution.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=maintenx_dev
POSTGRES_USER=maintenx_app
POSTGRES_PASSWORD=maintenx_dev_password_change_in_prod
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ASP.NET Core API Configuration
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5000
API_HTTPS_PORT=5001
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=maintenx_dev;Username=maintenx_app;Password=maintenx_dev_password_change_in_prod;Maximum Pool Size=50;"

# Next.js Web Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Mobile (Flutter) Configuration
MOBILE_API_BASE_URL=http://10.0.2.2:5000

